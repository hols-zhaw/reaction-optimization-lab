# Copy to .streamlit/secrets.toml for local use, and paste the same content into
# "Advanced settings > Secrets" on Streamlit Community Cloud. Never commit the real values.
instructor_password = "choose-a-password"

[reactor]
k10 = 0.0                  # pre-exponential factor of A -> P, 1/s
k20 = 0.0                  # pre-exponential factor of P -> S, 1/s
E1 = 0.0                   # activation energy of A -> P, J/mol
E2 = 0.0                   # activation energy of P -> S, J/mol
H1 = 0.0                   # reaction enthalpy of A -> P, J/mol
H2 = 0.0                   # reaction enthalpy of P -> S, J/mol
cp = 0.0                   # heat capacity, J/(kg K)
rho = 0.0                  # density, kg/m3
U = 0.0                    # heat transfer coefficient, W/(m2 K)
tube_diameter = 0.0        # m
value_ratio = 0.0          # product value relative to feed cost
catalyst_cost = 0.0        # margin units per unit of loading
temperature_limit = 0.0    # K
temperature_penalty = 0.0  # margin units per K above the limit
noise_sd_margin = 0.0      # margin units
noise_sd_fraction = 0.0    # yield and conversion
noise_sd_temperature = 0.0 # K

# Optional, used by the tests only: one set of conditions and its expected margin.
[check]
wall_temperature = 0.0
residence_time = 0.0
feed_concentration = 0.0
margin = 0.0
